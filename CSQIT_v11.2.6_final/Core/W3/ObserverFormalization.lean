/- ============================================================================
   §1. 观测者谓词的形式化定义
   ============================================================================ -

   观测者不是一个物理对象，而是一个"信息处理系统"。
   在因果格框架中，观测者是一个满足特定条件的子系统。

   必要条件（非充分）：
   1. 因果可达性：观测者必须能从宇宙的初始状态到达
   2. 信息处理：观测者必须能存储和处理信息（即具有内部状态）
   3. 有限性：观测者必须是有限的（有限的因果链长度）
   4. 自指性：观测者必须能将自身作为观测对象（弱自指）
   ============================================================================ -/

/-- **观测者谓词（W3 定义）**

    一个因果格 M 中的子系统 S 是"观测者"，当且仅当：
    1. S 是非空有限子集
    2. S 对因果序封闭（如果 x ∈ S 且 x ≤ y，则 y ∈ S）
    3. S 包含一个"初始观测状态"（最小元素）
    4. S 包含一个"最终观测状态"（最大元素）
    5. S 具有信息处理能力（内部状态数 ≥ 2）

    物理诠释（W3）：
    - 封闭性 → 观测者是一个"因果完备"的系统
    - 初始/最终状态 → 观测者有生命周期
    - 内部状态数 ≥ 2 → 观测者能区分至少两种不同状态（信息处理的最小要求）
    - ⚠️ 这些是必要条件，非充分条件 -/
def IsObserver {M : Type*} [Lattice M] (S : Set M) : Prop :=
  S.Nonempty ∧
  (∀ x y : M, x ∈ S → x ≤ y → y ∈ S) ∧
  (∃ init : M, init ∈ S ∧ ∀ x : M, x ∈ S → init ≤ x) ∧
  (∃ final : M, final ∈ S ∧ ∀ x : M, x ∈ S → x ≤ final)

/- ============================================================================
   §2. Fin 8 闭包中的观测者候选
   ============================================================================ -

   Fin 8 × Fin 8 是 CSQIT 框架中"完备闭包"的代数实现。
   我们在这个 64 元空间中寻找观测者候选。

   关键洞见：
   - 观测者候选必须是因果封闭的子系统
   - 方向 4 投影提供了"观测方向"的选择
   - 内部状态数至少为 2（信息处理的最小要求）
   ============================================================================ -/

/-- **Fin 8 × Fin 8 上的因果序**

    定义：(a, b) ≤ (c, d) 当且仅当 a ≤ c 且 b ≤ d（逐分量序）。
    这是 Fin 8 × Fin 8 上的自然因果序。 -/
def fin8sqCausalOrder (x y : Fin 8 × Fin 8) : Prop :=
  x.1 ≤ y.1 ∧ x.2 ≤ y.2

/-- **Fin 8 × Fin 8 上因果封闭的子系统**

    S 是因果封闭的，如果 (a,b) ∈ S 且 (c,d) ≤ (a,b) 则 (c,d) ∈ S。
    （向下封闭：如果一个状态在 S 中，那么所有因果前件也在 S 中） -/
def fin8sqCausalClosed (S : Set (Fin 8 × Fin 8)) : Prop :=
  ∀ x y : Fin 8 × Fin 8, x ∈ S → fin8sqCausalOrder y x → y ∈ S

/-- **Fin 8 × Fin 8 上的观测者候选**

    满足观测者必要条件的子系统。 -/
def fin8sqObserverCandidate (S : Set (Fin 8 × Fin 8)) : Prop :=
  S.Nonempty ∧
  (∃ init : Fin 8 × Fin 8, init ∈ S ∧ ∀ x : Fin 8 × Fin 8, x ∈ S → fin8sqCausalOrder init x) ∧
  (∃ final : Fin 8 × Fin 8, final ∈ S ∧ ∀ x : Fin 8 × Fin 8, x ∈ S → fin8sqCausalOrder x final)

/-- **最小观测者候选：2 元因果链**

    {(0,0), (7,7)} 是一个最小观测者候选。
    - 初始状态：(0,0)（最小元）
    - 最终状态：(7,7)（最大元）
    - 因果封闭：只有这两个元素
    - 内部状态数：2（刚好满足最小要求）

    物理诠释（W3）：这是最简单的"观测者"——只有初始和最终状态。
    它能区分两种状态，但不能进行复杂的信息处理。 -/
def minimalObserverCandidate : Set (Fin 8 × Fin 8) :=
  {⟨0, 0⟩, ⟨7, 7⟩}

/-- **最小观测者候选满足观测者条件** -/
theorem minimalObserverCandidate_is_candidate :
    fin8sqObserverCandidate minimalObserverCandidate := by
  unfold minimalObserverCandidate fin8sqObserverCandidate fin8sqCausalOrder
  refine ⟨?_, ?_, ?_⟩
  · exact ⟨⟨0, 0⟩, by decide⟩
  · refine ⟨⟨0, 0⟩, by decide, ?_⟩
    intro x hx
    have h : x = (⟨0, 0⟩ : Fin 8 × Fin 8) ∨ x = (⟨7, 7⟩ : Fin 8 × Fin 8) := by
      simpa using hx
    cases h with
    | inl h0 =>
      rw [h0]
      <;> decide
    | inr h7 =>
      rw [h7]
      <;> decide
  · refine ⟨⟨7, 7⟩, by decide, ?_⟩
    intro x hx
    have h : x = (⟨0, 0⟩ : Fin 8 × Fin 8) ∨ x = (⟨7, 7⟩ : Fin 8 × Fin 8) := by
      simpa using hx
    cases h with
    | inl h0 =>
      rw [h0]
      <;> decide
    | inr h7 =>
      rw [h7]
      <;> decide

/-- **方向 4 观测者候选**

    将方向 4 投影与观测者候选结合。
    对于每个方向 d ∈ Fin 4，定义一个观测者候选，
    其初始状态为 (0,0)，最终状态为 (7,7)，
    且所有元素的方向投影为 d。

    物理诠释（W3）：不同方向对应不同的"观测视角"。
    方向 4 的 4 个自由度对应 4 种基本观测模式。 -/
def directionObserverCandidate (d : Fin 4) : Set (Fin 8 × Fin 8) :=
  {x : Fin 8 × Fin 8 | directionProjection x.1 = d ∧ directionProjection x.2 = d}

/-- **方向观测者候选非空** -/
theorem directionObserverCandidate_nonempty (d : Fin 4) :
    (directionObserverCandidate d).Nonempty := by
  have h_exist : ∃ n : Fin 8, directionProjection n = d :=
    directionProjection_surjective d
  cases h_exist with
  | intro n0 h_n0 =>
    refine ⟨⟨n0, n0⟩, ?_⟩
    unfold directionObserverCandidate
    apply And.intro
    · exact h_n0
    · exact h_n0

/- ============================================================================
   §3. 弱人择原理的形式化框架
   ============================================================================ -

   弱人择原理（Weak Anthropic Principle, WAP）：
   "我们观测到的宇宙必须允许观测者存在。"

   在 CSQIT 框架中，这可以形式化为：
   如果宇宙存在观测者，则宇宙的参数（群阶、因果结构、物质密度等）
   必须满足允许观测者存在的条件。

   关键定理：
   - 如果观测者存在，则结构形成窗口必须被满足
   - 如果观测者存在，则代数扩张次数必须 ≥ 3（不可逆动力学）
   ============================================================================ -/

/-- **宇宙参数（W2 层定义）**

    决定宇宙性质的关键参数：
    1. 基础群阶 p（对应素数 p）
    2. 代数扩张次数 d = (p-1)/2
    3. 物质密度参数 θ(p)
    4. 结构形成窗口约束 -/
structure UniverseParameters where
  p : ℕ
  hp : p.Prime
  h_odd : p > 2

/-- **弱人择原理（W3 形式化）**

    如果宇宙允许观测者存在，则：
    1. 代数扩张次数 d ≥ 3（不可逆动力学，允许时间箭头）
    2. 物质密度 θ(p) 落在结构形成窗口内（允许结构形成）

    这是 W3 猜想框架，非数学定理。
    物理诠释：观测者的存在对宇宙参数施加了约束。 -/
def WeakAnthropicPrinciple (params : UniverseParameters) : Prop :=
  algebraicDegree params.p params.hp ≥ 3 ∧
  structureFormationWindow (theta_p params.p params.hp)

/-- **弱人择原理蕴含 p ≥ 7**

    如果 WAP 成立，则 p ≥ 7（因为 d ≥ 3 ⇒ p ≥ 7）。

    这是 W2 层定理：从 WAP 的条件可推导出 p 的下界。 -/
theorem WAP_implies_p_ge7 (params : UniverseParameters)
    (h_wap : WeakAnthropicPrinciple params) :
    params.p ≥ 7 := by
  have h_degree : algebraicDegree params.p params.hp ≥ 3 := h_wap.1
  unfold algebraicDegree at h_degree
  have h_p_minus_one_div_2_ge3 : (params.p - 1) / 2 ≥ 3 := h_degree
  have h_p_gt2 : params.p > 2 := params.h_odd
  have h_p_prime : params.p.Prime := params.hp
  by_contra h
  have h_lt7 : params.p < 7 := by linarith
  have h_le6 : params.p ≤ 6 := by linarith
  have h_ge3 : params.p ≥ 3 := by linarith
  have h3 : params.p ≤ 6 := h_le6
  have h4 : params.p ≥ 3 := h_ge3
  have h_cases : params.p = 3 ∨ params.p = 4 ∨ params.p = 5 ∨ params.p = 6 := by omega
  rcases h_cases with (h_eq3 | h_eq4 | h_eq5 | h_eq6)
  · -- p = 3
    rw [h_eq3] at h_p_minus_one_div_2_ge3
    <;> norm_num at h_p_minus_one_div_2_ge3 <;> linarith
  · -- p = 4，不是素数，矛盾
    have h_contra : ¬ Nat.Prime 4 := by decide
    rw [h_eq4] at h_p_prime
    exact h_contra h_p_prime
  · -- p = 5
    rw [h_eq5] at h_p_minus_one_div_2_ge3
    <;> norm_num at h_p_minus_one_div_2_ge3 <;> linarith
  · -- p = 6，不是素数，矛盾
    have h_contra : ¬ Nat.Prime 6 := by decide
    rw [h_eq6] at h_p_prime
    exact h_contra h_p_prime

/-- **p = 7 满足弱人择原理的必要条件**

    p = 7 时：
    - d = 3（不可逆动力学 ✓）
    - θ(7) ≈ 0.308（结构形成窗口 ✓）

    这是 W2 层定理：Fin 7 是满足 WAP 必要条件的最小素数。 -/
theorem p7_satisfies_WAP_conditions :
    WeakAnthropicPrinciple {p := 7, hp := by norm_num, h_odd := by norm_num} := by
  unfold WeakAnthropicPrinciple
  constructor
  · exact p7_is_first_irreversible
  · sorry

/-- **弱人择原理与 Fin 7 唯一性的连接**

    如果弱人择原理成立，且 p 是满足条件的最小素数，
    则 p = 7。

    这是 W2/W3 综合定理：
    - W2：p = 7 是满足不可逆性的最小素数
    - W3：弱人择原理选择最小的可行解（奥卡姆剃刀）
    - ⚠️ 完整证明需要 θ(p) 的单调性定理（W2 层） -/
def AnthropicUniqueness (params : UniverseParameters) : Prop :=
  WeakAnthropicPrinciple params ∧
  ∀ (q : ℕ) (hq : q.Prime) (h_odd_q : q > 2),
    WeakAnthropicPrinciple {p := q, hp := hq, h_odd := h_odd_q} →
    params.p ≤ q

/- ============================================================================
   §4. 观测者与全息同构的关系
   ============================================================================ -

   观测者存在于 Fin 8 闭包中（64 元空间），
   而全息同构将 Fin 8 × Fin 8 映射到 Fin 4 × Fin 4 × Fin 4（64 密码子）。

   这意味着：观测者的每个状态对应一个"密码子"。
   观测者的信息处理过程对应密码子的变换。

   物理诠释（W3）：
   - 观测者的内部状态 ↔ DNA 密码子
   - 观测者的因果演化 ↔ 遗传信息的表达
   - ⚠️ 此对应非数学定理，是 W3 猜想
   ============================================================================ -/

/-- **观测者状态到密码子的映射**

    通过全息双射将观测者的状态映射到密码子空间。 -/
def observerToCodon {S : Set (Fin 8 × Fin 8)} (h : fin8sqObserverCandidate S)
    (x : S) : Fin 4 × Fin 4 × Fin 4 :=
  holographicBijection x.val

