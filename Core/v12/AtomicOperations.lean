/-! ============================================================================
   §1. 原子操作的定义
   ============================================================================ -/

variable {W : Type*} [Weave W]

/-- **时间原子（Temporal Atom）**:
    不能分解为两个非平凡顺序复合的操作。
    时间深度的基本单位。 -/
def isTemporalAtom (w : W) : Prop :=
  w ≠ skip ∧ ∀ (a b : W), seq a b = w → a = skip ∨ b = skip

/-- **空间原子（Spatial Atom）**:
    不能分解为两个非平凡并行复合的操作。
    空间广度的基本单位。 -/
def isSpatialAtom (w : W) : Prop :=
  w ≠ empty ∧ ∀ (a b : W), par a b = w → a = empty ∨ b = empty

/-- **基本原子（Elementary Atom）**:
    既是时间原子又是空间原子——
    不能在时间方向或空间方向上进一步分解。
    这就是"基本粒子"的代数对应物。 -/
def isElementaryAtom (w : W) : Prop :=
  isTemporalAtom w ∧ isSpatialAtom w

