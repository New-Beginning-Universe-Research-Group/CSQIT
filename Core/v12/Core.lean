import Mathlib.Data.Complex.Basic
import Mathlib.Algebra.Group.Defs
import Mathlib.Data.Nat.Basic

namespace CSQIT.v12

/-! ============================================================================
   第一公理：编织双幺半群（Weave Bi-Monoid）
   
   这是 v12 的唯一第一性实体：编织操作及其两种复合方式。
   顺序复合 = 时间，并行复合 = 空间。
   ============================================================================ -/

/-- **编织操作（Weave Operation）**

v12 中唯一的第一性实体。
不是"在时空中发生的操作"，而是"操作本身就是时空的构造者"。

每个编织操作 w 有两个维度：
· 时间深度：w 由多少层顺序复合构成
· 空间广度：w 由多少个并行操作构成
-/
class Weave (W : Type*) where
  /-- 顺序复合（时间方向）：先做 a，再做 b -/
  seq : W → W → W
  /-- 空操作（时间单位）：不做任何事，零时间深度 -/
  skip : W
  /-- 并行复合（空间方向）：a 和 b 并排发生 -/
  par : W → W → W
  /-- 空编织（空间单位）：没有操作，零空间广度 -/
  empty : W

  /-- 顺序复合的结合律：
      先做 a 再做 (b 然后 c) = 先做 (a 然后 b) 再做 c -/
  seq_assoc : ∀ (a b c : W), seq a (seq b c) = seq (seq a b) c
  /-- 顺序左单位：先跳过再做 a = a -/
  seq_left_skip : ∀ (a : W), seq skip a = a
  /-- 顺序右单位：先做 a 再跳过 = a -/
  seq_right_skip : ∀ (a : W), seq a skip = a

  /-- 并行复合的交换律：a 并排 b = b 并排 a
      空间是对称的，没有"左边"和"右边"的绝对区别 -/
  par_comm : ∀ (a b : W), par a b = par b a
  /-- 并行复合的结合律：
      a 并排 (b 并排 c) = (a 并排 b) 并排 c -/
  par_assoc : ∀ (a b c : W), par a (par b c) = par (par a b) c
  /-- 并行左单位：空操作并排 a = a -/
  par_left_empty : ∀ (a : W), par empty a = a
  /-- 并行右单位：a 并排空操作 = a -/
  par_right_empty : ∀ (a : W), par a empty = a

  /-- **编织交换律（核心公理）**：
      时间和空间的交互方式——顺序和并行可以交换。
      
    物理意义：
      如果有两对并行操作 (a ‖ b) 然后 (c ‖ d)
      = 先做 (a 然后 c) 并排 先做 (b 然后 d)
      
    这是时空的基本一致性条件：
      先并行再顺序 = 先顺序再并行
      
    也叫"中间四交换"或"编织一致性"。 -/
  interchange : ∀ (a b c d : W),
    seq (par a b) (par c d) = par (seq a c) (seq b d)

/-! ============================================================================
   导出概念 1：因果序
   
   从顺序复合导出，不需要额外公理。
   a ≤ b 意味着：a 在 b 的因果过去，b 可以分解为 a 加上后续操作。
   ============================================================================ -/

namespace Weave

variable {W : Type*} [Weave W]

/-- **因果偏序（Causal Preorder）**

a 在 b 的因果过去，当且仅当存在 c 使得 seq a c = b。

**物理意义**：
  b 发生在 a 之后 = b 可以分解为"a 加上更多的编织"
  这就是"时间箭头"——由顺序复合的方向定义。

注意：目前这只是预序（preorder），还需要反对称性才能成为偏序。
反对称性意味着：如果 a ≤ b 且 b ≤ a，则 a = b。
这在物理上对应"没有时间循环"。
-/
def causalLe (a b : W) : Prop := ∃ (c : W), seq a c = b

/-- 因果序的中缀表示 -/
infixl:50 " ≤ᶜ " => causalLe

/-- **因果严格序**：a < b 当且仅当 a ≤ b 且 a ≠ b -/
def causalLt (a b : W) : Prop := causalLe a b ∧ a ≠ b

/-- 因果严格序的中缀表示 -/
infixl:50 " <ᶜ " => causalLt

/-- **因果自反性**：每个操作都在自己的因果过去
    （取 c = skip，则 seq a skip = a）-/
theorem causalLe_refl (a : W) : a ≤ᶜ a := by
  use skip
  exact seq_right_skip a

/-- **因果传递性**：如果 a ≤ b 且 b ≤ c，则 a ≤ c
    （时间的传递性由顺序复合的结合律导出）-/
theorem causalLe_trans {a b c : W} (h1 : a ≤ᶜ b) (h2 : b ≤ᶜ c) : a ≤ᶜ c := by
  rcases h1 with ⟨d, hd⟩
  rcases h2 with ⟨e, he⟩
  use seq d e
  calc
    seq a (seq d e) = seq (seq a d) e := by rw [seq_assoc]
    _ = seq b e := by rw [hd]
    _ = c := he

/-! ============================================================================
   导出概念 2：时间深度与空间广度
   
   用归纳结构定义"纯顺序"和"纯并行"的度量。
   这里用结构复杂度方法：时间深度 = 顺序复合树的高度。
   
   注意：在一般的 Weave 结构中，深度不是唯一的（不同分解可能有不同深度）。
   我们定义"最小时间深度"——达到该操作所需的最小编织步数。
   ============================================================================ -/

/-- **原子操作的谓词**：不能再分解为 seq a b，除非 a=skip 或 b=skip
    时间深度的基本单位。 -/
def isAtomicTime (a : W) : Prop :=
  a ≠ skip ∧ ∀ (x y : W), seq x y = a → x = skip ∨ y = skip

/-- **原子操作的谓词（空间方向）**：不能再分解为 par a b，除非 a=empty 或 b=empty
    空间广度的基本单位。 -/
def isAtomicSpace (a : W) : Prop :=
  a ≠ empty ∧ ∀ (x y : W), par x y = a → x = empty ∨ y = empty

/-! ============================================================================
   导出概念 3：量子振幅
   
   每个编织操作有一个复数振幅。
   顺序复合对应振幅相乘（时间演化 = 幺正变换）。
   并行复合呢？这是一个需要思考的问题...
   
   在量子力学中，独立系统的并行复合对应张量积，
   而振幅的组合方式取决于测量的是哪个系统。
   
   这里我们先只假设顺序复合的振幅乘法性。
   ============================================================================ -/

/-- **带振幅的编织操作**

扩展核心 Weave 结构，增加量子振幅。

**为什么振幅是内禀的？**
  因为编织操作不仅"发生"，而且以特定的"权重"或"相位"发生。
  这就是量子力学的概率幅——宇宙不是确定性地计算，
  而是以复数振幅的方式"叠加"所有可能的计算路径。
-/
class WeaveAmplitude (W : Type*) [Weave W] where
  /-- 量子振幅：每个编织操作对应一个复数 -/
  amplitude : W → ℂ
  /-- 顺序复合的振幅 = 振幅的乘积
      这就是量子力学中的"时间演化幺正性"的离散版本 -/
  amplitude_seq : ∀ (a b : W), amplitude (seq a b) = amplitude a * amplitude b
  /-- skip 的振幅 = 1（恒等操作的振幅是幺元）-/
  amplitude_skip : amplitude (skip : W) = 1

/-! ============================================================================
   基本定理：从公理直接导出的性质
   ============================================================================ -/

namespace Theorems

variable {W : Type*} [Weave W]

/-- **interchange 的单位元推论**：
    如果第二个操作都是 skip，那么 par 与 seq 交换 -/
theorem par_seq_skip (a b : W) :
    seq (par a b) (par skip skip) = par a b := by
  have h : seq (par a b) (par skip skip) = par (seq a skip) (seq b skip) :=
    interchange a b skip skip
  rw [h]
  rw [seq_right_skip a, seq_right_skip b]

/-- **猜想：par skip skip = skip**
    
    这个命题在当前公理下不可证明（反例：取 par a b = a 也满足所有公理）。
    但在物理上合理的模型中应该成立——两个"无操作"并行还是"无操作"。
    可以作为额外公理加入，或者从更强的结构中导出。 -/
def par_skip_skip_conj : Prop := par (skip : W) skip = skip

end Theorems

end Weave

end CSQIT.v12
