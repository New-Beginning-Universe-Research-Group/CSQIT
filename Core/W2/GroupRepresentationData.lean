/-! ============================================================================
   §1. A₅ 的基本数据
   ============================================================================ -/

/- ThreeGroupHierarchy.A5_order 从 ThreeGroupHierarchy 导入 -/

/-- A₅ 的共轭类大小：单位元、双对换、3-循环、5-循环、5-循环' -/
def A5_conjugacy_classes : List ℕ := [1, 15, 20, 12, 12]

theorem A5_conjugacy_classes_sum :
    A5_conjugacy_classes.sum = CSQIT.W1.ThreeGroupHierarchy.A5_order := by
  rfl

/-- A₅ 的不可约表示维数：1, 3, 3, 4, 5 -/
def A5_irrep_dimensions : List ℕ := [1, 3, 3, 4, 5]

theorem A5_irrep_dim_sq_sum :
    (A5_irrep_dimensions.map (· ^ 2)).sum = CSQIT.W1.ThreeGroupHierarchy.A5_order := by
  rfl

/-! ============================================================================
   §2. PSL(2,7) 的基本数据
   ============================================================================ -/

/- ThreeGroupHierarchy.PSL27_order 从 ThreeGroupHierarchy 导入 -/

/-- PSL(2,7) 的共轭类大小：
    单位元、对合(21)、3阶(56)、7阶(24)、7阶'(24)、4阶(42) -/
def PSL27_conjugacy_classes : List ℕ := [1, 21, 56, 24, 24, 42]

theorem PSL27_conjugacy_classes_sum :
    PSL27_conjugacy_classes.sum = CSQIT.W1.ThreeGroupHierarchy.PSL27_order := by
  rfl

/-- PSL(2,7) 的不可约表示维数：1, 3, 3, 6, 7, 8 -/
def PSL27_irrep_dimensions : List ℕ := [1, 3, 3, 6, 7, 8]

theorem PSL27_irrep_dim_sq_sum :
    (PSL27_irrep_dimensions.map (· ^ 2)).sum = CSQIT.W1.ThreeGroupHierarchy.PSL27_order := by
  rfl

/-! ============================================================================
   §3. 与三锁常数的数值对比
   ============================================================================ -/

/- totalClosureDenominator 从 ThreeGroupHierarchy 导入的 ThreeGroupHierarchy.totalClosure 派生 -/
def totalClosureDenominator : ℕ := CSQIT.W1.ThreeGroupHierarchy.totalClosure

/-- 420 = lcm(60, 168) / 2
    这是 v12 最惊人的发现。
    注意：数值上 lcm(60,168)=lcm(12,60,168)=840，因为 12|60 -/
theorem totalClosure_eq_lcm_div_2 :
    totalClosureDenominator = Nat.lcm CSQIT.W1.ThreeGroupHierarchy.A5_order CSQIT.W1.ThreeGroupHierarchy.PSL27_order / 2 := by
  rfl

/-- Ω_b 的分子 = 20 = A₅ 中 3-循环共轭类的大小
    
    重子物质 ↔ A₅ 的 3-循环？
    
    物理解释（猜想）：
    重子是三维物质，对应 A₅（三维正多面体对称）。
    3-循环是 A₅ 中"改变 3 个元素"的操作，
    对应重子的"三夸克"结构？
 -/
theorem Omega_b_numerator_eq_A5_3cycle_class_size :
    20 ∈ A5_conjugacy_classes := by
  simp [A5_conjugacy_classes]
  <;> decide

/-- Ω_b = 20/420 = 1/21
    
    21 = 3 × 7 = PSL(2,7) 中对合的个数
    
    所以 Ω_b = 1 / (PSL(2,7) 对合数)
    而 20 是 A₅ 的 3-循环数。
    
    这两个不同群的量怎么会联系在一起？
    也许重子物质是两个群的某种"耦合项"？
 -/
theorem Omega_b_denominator_eq_PSL27_involutions :
    totalClosureDenominator / 20 = 21 := by
  rfl

/-! ============================================================================
   §4. 17 的出现
   
   289 = 17²
   而 17 = 2 + 3 + 5 + 7
   
   2, 3, 5, 7 是 420 的素因子，也是两个基本有限单群的素因子。
   
   暗能量 = (基本素数之和)² / 420
   
   这很有美感，但还需要更多证据。
   ============================================================================ -/

/-- 四个基本素数：2, 3, 5, 7
    来自 A₅ 和 PSL(2,7) 的素因子的并集 -/
def basic_primes : List ℕ := [2, 3, 5, 7]

/-- 基本素数之和 = 17 -/
theorem basic_primes_sum_eq_17 :
    basic_primes.sum = 17 := by
  rfl

/-- 暗能量分子 = 289 = 17² = (基本素数之和)² -/
theorem dark_energy_numerator_eq_sq_of_sum :
    289 = (basic_primes.sum) ^ 2 := by
  rfl

